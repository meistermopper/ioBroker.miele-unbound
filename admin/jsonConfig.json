{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tabPairing": {
      "type": "panel",
      "label": "Login & Pairing",
      "items": {
        "headerPairing": {
          "type": "header",
          "size": 3,
          "text": "Miele Account Pairing (One-time Setup)"
        },
        "infoPairing": {
          "type": "staticText",
          "text": "pairing_instruction",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "country": {
          "type": "select",
          "label": "Country",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4,
          "options": [
            { "label": "Germany", "value": "de" },
            { "label": "Austria", "value": "at" },
            { "label": "Switzerland", "value": "ch" },
            { "label": "Netherlands", "value": "nl" },
            { "label": "United Kingdom", "value": "gb" },
            { "label": "France", "value": "fr" },
            { "label": "Italy", "value": "it" },
            { "label": "Spain", "value": "es" },
            { "label": "Other", "value": "other" }
          ]
        },
        "btnOpenLogin": {
          "type": "sendTo",
          "label": "Open Login Page",
          "command": "getAuthorizeUrl",
          "openUrl": true,
          "variant": "contained",
          "color": "primary",
          "jsonData": "{ \"country\": \"${data.country}\" }",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "step1Header": {
          "type": "header",
          "size": 5,
          "text": "step1_header",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "step1Text": {
          "type": "staticText",
          "text": "step1_text",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "step2Header": {
          "type": "header",
          "size": 5,
          "text": "step2_header",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "step2Text": {
          "type": "staticText",
          "text": "step2_text",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "step3Header": {
          "type": "header",
          "size": 5,
          "text": "step3_header",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "step3Text": {
          "type": "staticText",
          "text": "step3_text",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "redirectUrl": {
          "type": "text",
          "label": "miele:// redirect URL",
          "help": "Paste the captured miele:// or redirect URL here",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 8,
          "lg": 8,
          "xl": 8
        },
        "btnFetchKey": {
          "type": "sendTo",
          "label": "Fetch GroupKey",
          "command": "fetchGroupKey",
          "variant": "contained",
          "color": "primary",
          "useNative": true,
          "jsonData": "{ \"redirectUrl\": \"${data.redirectUrl}\" }",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "dividerPairing": {
          "type": "divider"
        },
        "pairingStatus": {
          "type": "staticText",
          "text": "pairing_status_info",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "groupId": {
          "type": "text",
          "label": "Household GroupID",
          "readOnly": true,
          "copyToClipboard": true,
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "tabBackup": {
      "type": "panel",
      "label": "Credentials & Backup",
      "items": {
        "headerCredentials": {
          "type": "header",
          "size": 3,
          "text": "Household Credentials (GroupId & GroupKey)"
        },
        "credentialsDesc": {
          "type": "staticText",
          "text": "credentials_desc",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "manualGroupId": {
          "type": "text",
          "label": "Household GroupID",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "manualGroupKey": {
          "type": "password",
          "label": "Household GroupKey (64 Bytes Hex)",
          "xs": 12,
          "sm": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "dividerBackup": {
          "type": "divider"
        },
        "headerBackup": {
          "type": "header",
          "size": 3,
          "text": "Encrypted Export & Import (AES-256-GCM)"
        },
        "backupDesc": {
          "type": "staticText",
          "text": "backup_desc",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "backupPassphrase": {
          "type": "password",
          "label": "Master Passphrase for Encryption/Decryption",
          "repeat": true,
          "visible": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "btnExportBackup": {
          "type": "sendTo",
          "label": "Export Encrypted Backup",
          "command": "exportBackup",
          "variant": "contained",
          "color": "primary",
          "newLine": true,
          "disabled": "!data.backupPassphrase || data.backupPassphrase.length < 4",
          "data": {
            "passphrase": "${data.backupPassphrase}"
          },
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "backupPayload": {
          "type": "text",
          "label": "Encrypted Backup Data (Paste here to restore)",
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 9,
          "lg": 9,
          "xl": 9
        },
        "btnImportBackup": {
          "type": "sendTo",
          "label": "Import / Restore",
          "command": "importBackup",
          "variant": "contained",
          "color": "primary",
          "disabled": "!data.backupPayload || !data.backupPassphrase",
          "data": {
            "backup": "${data.backupPayload}",
            "passphrase": "${data.backupPassphrase}"
          },
          "xs": 12,
          "sm": 12,
          "md": 3,
          "lg": 3,
          "xl": 3
        }
      }
    },
    "tabDevices": {
      "type": "panel",
      "label": "Appliances",
      "items": {
        "headerDevices": {
          "type": "header",
          "size": 3,
          "text": "Network & Appliances"
        },
        "autoDiscovery": {
          "type": "checkbox",
          "label": "Auto-Discovery via mDNS (_mieleathome._tcp)",
          "help": "Enable automatic detection on the local network (may not work across Docker bridge)",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "manualDevices": {
          "type": "table",
          "label": "Static IP Addresses (e.g. for Docker / VLAN)",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "items": [
            {
              "type": "text",
              "attr": "ip",
              "title": "IP Address (e.g. 192.168.1.127)",
              "width": "200px"
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Appliance Name / Notes (optional)",
              "width": "250px"
            },
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Active",
              "width": "80px",
              "default": true
            }
          ]
        }
      }
    },
    "tabSettings": {
      "type": "panel",
      "label": "Settings",
      "items": {
        "headerSettings": {
          "type": "header",
          "size": 3,
          "text": "Polling & Intervals"
        },
        "pollIntervalActive": {
          "type": "number",
          "label": "Active Poll Interval (Seconds)",
          "help": "Interval when a machine is running or programmed (Recommended: 5)",
          "min": 2,
          "max": 60,
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "pollIntervalIdle": {
          "type": "number",
          "label": "Idle Poll Interval (Seconds)",
          "help": "Interval when machines are switched off or on standby (Recommended: 20-30)",
          "min": 5,
          "max": 300,
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "language": {
          "type": "select",
          "label": "Text State Language",
          "xs": 12,
          "sm": 12,
          "md": 4,
          "lg": 4,
          "xl": 4,
          "options": [
            { "label": "German (Deutsch)", "value": "de" },
            { "label": "English", "value": "en" }
          ]
        },
        "dividerSettings1": {
          "type": "divider"
        },
        "headerEco": {
          "type": "header",
          "size": 3,
          "text": "EcoFeedback & Measurement"
        },
        "ecoFeedback": {
          "type": "checkbox",
          "label": "Enable EcoFeedback readings (Water & Energy)",
          "help": "Reads targeted DOP2 registers where supported without brute-force scanning",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "dividerSettings2": {
          "type": "divider"
        },
        "headerControl": {
          "type": "header",
          "size": 3,
          "text": "Remote Appliance Control"
        },
        "allowControl": {
          "type": "checkbox",
          "label": "Allow remote control commands (Start, Stop, Pause, Power, Light)",
          "help": "WARNING: Only works if MobileStart is physically enabled on the machine",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    }
  }
}
