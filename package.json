{
  "name": "iobroker.miele-unbound",
  "version": "1.0.0",
  "description": "Connect Miele@Home appliances locally without cloud dependence, combining local speed with rich device profiles",
  "author": {
    "name": "meistermopper",
    "email": "meister.mopper@gmail.com"
  },
  "homepage": "https://github.com/meistermopper/ioBroker.miele-unbound",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "Miele",
    "Miele@Home",
    "local",
    "DOP2",
    "MieleH256",
    "SmartHome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meistermopper/ioBroker.miele-unbound.git"
  },
  "bugs": {
    "url": "https://github.com/meistermopper/ioBroker.miele-unbound/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin",
    "build",
    "io-package.json",
    "LICENSE",
    "README.md",
    "README_de.md"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "multicast-dns": "^7.2.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-changelog": "^5.2.1",
    "@alcalzone/release-script-plugin-git": "^5.2.0",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@alcalzone/release-script-plugin-package": "^5.2.0",
    "@alcalzone/release-script-plugin-version": "^5.2.0",
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/testing": "^6.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/multicast-dns": "^7.2.3",
    "@types/node": "^22.13.0",
    "chai": "^4.4.1",
    "husky": "^9.1.7",
    "mocha": "^12.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "test:package": "mocha test/package.js --exit",
    "test:unit": "mocha test/unit.test.js --exit",
    "test:ts": "tsc --noEmit",
    "test": "npm run test:ts && npm run build && npm run test:package && npm run test:unit",
    "check": "biome check .",
    "format": "biome format --write .",
    "check:repo": "npx @iobroker/repochecker meistermopper/ioBroker.miele-unbound main --local",
    "sync-docs": "node scripts/sync-docs.js",
    "build": "npm run sync-docs && node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "dev": "node scripts/patch-ps-tree.js && dev-server watch",
    "lint": "biome check .",
    "test:local": "npm run lint && npm run test:ts && npm run build && npm run test:package && npm run test:unit",
    "translate": "translate-adapter",
    "release": "release-script --addPlaceholder",
    "release-before-check": "node scripts/check-wip.js && npm run test:local",
    "release-before-commit": "npm run translate && npm run manage-changelogs && npm run sync-docs && npm run format && git add -A",
    "manage-changelogs": "node scripts/manage-changelogs.js"
  }
}
